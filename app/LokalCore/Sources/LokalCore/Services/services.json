{
  "$comment": "Well-known local services. See CONTRIBUTING.md for the format. Matching order: processNames, commandPatterns, then ports (hint only). auxiliary: true marks supporting ports that are hidden by default.",
  "services": [
    { "id": "postgres", "name": "Postgres", "kind": "database", "icon": "cylinder.split.1x2", "ports": [5432], "processNames": ["postgres", "postgres_real"], "urlTemplate": "postgres://localhost:{port}", "openInBrowser": false },
    { "id": "mysql", "name": "MySQL", "kind": "database", "icon": "cylinder.split.1x2", "ports": [3306], "processNames": ["mysqld"], "urlTemplate": "mysql://localhost:{port}", "openInBrowser": false },
    { "id": "mariadb", "name": "MariaDB", "kind": "database", "icon": "cylinder.split.1x2", "processNames": ["mariadbd"], "urlTemplate": "mysql://localhost:{port}", "openInBrowser": false },
    { "id": "redis", "name": "Redis", "kind": "cache", "icon": "memorychip", "ports": [6379], "processNames": ["redis-server"], "urlTemplate": "redis://localhost:{port}", "openInBrowser": false },
    { "id": "valkey", "name": "Valkey", "kind": "cache", "icon": "memorychip", "processNames": ["valkey-server"], "urlTemplate": "redis://localhost:{port}", "openInBrowser": false },
    { "id": "memcached", "name": "Memcached", "kind": "cache", "icon": "memorychip", "ports": [11211], "processNames": ["memcached"], "urlTemplate": "memcached://localhost:{port}", "openInBrowser": false },
    { "id": "mongodb", "name": "MongoDB", "kind": "database", "icon": "leaf", "ports": [27017], "processNames": ["mongod"], "urlTemplate": "mongodb://localhost:{port}", "openInBrowser": false },
    { "id": "elasticsearch", "name": "Elasticsearch", "kind": "search", "icon": "magnifyingglass", "ports": [9200], "commandPatterns": ["org\\.elasticsearch\\.bootstrap"] },
    { "id": "opensearch", "name": "OpenSearch", "kind": "search", "icon": "magnifyingglass", "commandPatterns": ["org\\.opensearch\\.bootstrap"] },
    { "id": "meilisearch", "name": "Meilisearch", "kind": "search", "icon": "magnifyingglass", "ports": [7700], "processNames": ["meilisearch"] },
    { "id": "typesense", "name": "Typesense", "kind": "search", "icon": "magnifyingglass", "ports": [8108], "processNames": ["typesense-server"] },
    { "id": "rabbitmq", "name": "RabbitMQ", "kind": "queue", "icon": "tray.full", "ports": [5672, 15672], "commandPatterns": ["rabbitmq|rabbit_"], "urlTemplate": "amqp://localhost:{port}", "openInBrowser": false },
    { "id": "kafka", "name": "Kafka", "kind": "queue", "icon": "tray.full", "ports": [9092], "commandPatterns": ["kafka\\.Kafka|kafka-server"], "openInBrowser": false },
    { "id": "nats", "name": "NATS", "kind": "queue", "icon": "tray.full", "ports": [4222], "processNames": ["nats-server"], "urlTemplate": "nats://localhost:{port}", "openInBrowser": false },
    { "id": "minio", "name": "MinIO", "kind": "storage", "icon": "externaldrive", "ports": [9000, 9001], "processNames": ["minio"] },
    { "id": "mailpit", "name": "Mailpit", "kind": "tool", "icon": "envelope", "ports": [8025, 1025], "processNames": ["mailpit", "MailHog", "mailhog"] },
    { "id": "vite", "name": "Vite", "kind": "dev-server", "icon": "bolt.fill", "ports": [5173, 4173], "commandPatterns": ["(^|/)vite(\\.js)?(\\s|$)"] },
    { "id": "next", "name": "Next.js", "kind": "dev-server", "icon": "triangle.fill", "ports": [3000], "commandPatterns": ["^next-server", "(^|/)next(\\.js)?\\s+(dev|start)"] },
    { "id": "nuxt", "name": "Nuxt", "kind": "dev-server", "icon": "mountain.2.fill", "commandPatterns": ["(^|/)nuxi?(\\.mjs|\\.js)?\\s|\\.nuxt/"] },
    { "id": "astro", "name": "Astro", "kind": "dev-server", "icon": "sparkles", "ports": [4321], "commandPatterns": ["(^|/)astro(\\.js)?\\s+(dev|preview)"] },
    { "id": "remix", "name": "React Router", "kind": "dev-server", "icon": "arrow.triangle.branch", "commandPatterns": ["(^|/)(remix|react-router)(\\.js)?\\s+dev"] },
    { "id": "storybook", "name": "Storybook", "kind": "dev-server", "icon": "book", "ports": [6006], "commandPatterns": ["(^|/)storybook(\\.js)?\\s"] },
    { "id": "webpack", "name": "webpack dev server", "kind": "dev-server", "icon": "shippingbox", "commandPatterns": ["webpack(-dev-server)?(\\.js)?\\s+serve|webpack-dev-server"] },
    { "id": "expo", "name": "Expo", "kind": "dev-server", "icon": "iphone", "ports": [8081, 19000], "commandPatterns": ["(^|/)expo(\\.js)?\\s+start|metro"] },
    { "id": "wrangler", "name": "Wrangler", "kind": "dev-server", "icon": "cloud", "ports": [8787], "commandPatterns": ["(^|/)wrangler(\\.js)?\\s+(dev|pages)"] },
    { "id": "workerd", "name": "workerd", "kind": "dev-server", "icon": "cloud", "processNames": ["workerd"] },
    { "id": "node-inspector", "name": "Node inspector", "kind": "tool", "icon": "ladybug", "ports": [9229, 9230, 9231, 9232], "openInBrowser": false, "auxiliary": true },
    { "id": "python-debugger", "name": "Python debugger", "kind": "tool", "icon": "ladybug", "ports": [5678], "openInBrowser": false, "auxiliary": true },
    { "id": "rails", "name": "Rails", "kind": "dev-server", "icon": "diamond", "ports": [3000], "processNames": ["puma"], "commandPatterns": ["(^|/)(rails|puma|unicorn)(\\s|$)|bin/rails"] },
    { "id": "django", "name": "Django", "kind": "dev-server", "icon": "leaf", "ports": [8000], "commandPatterns": ["manage\\.py\\s+runserver|django"] },
    { "id": "flask", "name": "Flask", "kind": "dev-server", "icon": "flask", "ports": [5000], "commandPatterns": ["(^|/)flask(\\s|$)|flask\\s+run"] },
    { "id": "uvicorn", "name": "Uvicorn", "kind": "dev-server", "icon": "hare", "ports": [8000], "processNames": ["uvicorn", "gunicorn", "hypercorn"], "commandPatterns": ["(^|/)(uvicorn|gunicorn|hypercorn)(\\s|$)"] },
    { "id": "python-http", "name": "Python http.server", "kind": "web", "icon": "globe", "commandPatterns": ["-m\\s+http\\.server"] },
    { "id": "phoenix", "name": "Phoenix", "kind": "dev-server", "icon": "flame", "ports": [4000], "commandPatterns": ["phx\\.server|mix\\s+phx"] },
    { "id": "laravel", "name": "Laravel", "kind": "dev-server", "icon": "diamond", "commandPatterns": ["artisan\\s+serve"] },
    { "id": "jupyter", "name": "Jupyter", "kind": "tool", "icon": "book", "ports": [8888], "commandPatterns": ["jupyter"] },
    { "id": "prisma-studio", "name": "Prisma Studio", "kind": "tool", "icon": "tablecells", "ports": [5555], "commandPatterns": ["prisma\\s+studio"] },
    { "id": "supabase", "name": "Supabase", "kind": "tool", "icon": "bolt.horizontal", "ports": [54321, 54323], "commandPatterns": ["supabase"] },
    { "id": "ollama", "name": "Ollama", "kind": "ai", "icon": "brain", "ports": [11434], "processNames": ["ollama"], "openInBrowser": false },
    { "id": "lm-studio", "name": "LM Studio", "kind": "ai", "icon": "brain", "ports": [1234], "processNames": ["LM Studio", "lms"], "openInBrowser": false },
    { "id": "docker", "name": "Docker Desktop", "kind": "container", "icon": "shippingbox", "processNames": ["com.docker.backend", "com.docker.vpnkit", "vpnkit"] },
    { "id": "orbstack", "name": "OrbStack", "kind": "container", "icon": "shippingbox", "processNames": ["OrbStack Helper", "orbstack", "OrbStack"] },
    { "id": "nginx", "name": "nginx", "kind": "web", "icon": "server.rack", "ports": [80, 8080], "processNames": ["nginx"] },
    { "id": "caddy", "name": "Caddy", "kind": "web", "icon": "server.rack", "ports": [2019], "processNames": ["caddy"] },
    { "id": "ngrok", "name": "ngrok", "kind": "tool", "icon": "point.3.connected.trianglepath.dotted", "ports": [4040], "processNames": ["ngrok"] },
    { "id": "syncthing", "name": "Syncthing", "kind": "tool", "icon": "arrow.triangle.2.circlepath", "ports": [8384], "processNames": ["syncthing"] },
    { "id": "http-generic", "name": "HTTP server", "kind": "web", "icon": "globe", "ports": [8080, 8000, 8888] }
  ]
}
